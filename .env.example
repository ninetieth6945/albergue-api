# Copia este archivo como .env para desarrollo local.
#
# Cadena POOLED de Neon (la que trae -pooler y pgbouncer=true)
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5"

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN="http://localhost:5173,https://albergueluisaaron.web.app,https://albergueluisaaron.firebaseapp.com,https://albergueluisaaron.org"

# JSON completo de la cuenta de servicio de Firebase en UNA sola línea
# (o usa GOOGLE_APPLICATION_CREDENTIALS apuntando al archivo)
FIREBASE_SERVICE_ACCOUNT=

# Correos que se convierten en administradores (nivel 3) la primera vez que entran
ADMIN_EMAILS=""

# Secreto para firmar los enlaces de /archivos (pon uno largo y aleatorio)
ARCHIVOS_SECRET=""

# Solo para desarrollo local sin token de Firebase:
# ALLOW_ANONYMOUS=true
# PORT=3004
